{
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	file_server
	try_files {path} {path}.html {path}/index.html
	handle_errors {
		rewrite * /404.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
